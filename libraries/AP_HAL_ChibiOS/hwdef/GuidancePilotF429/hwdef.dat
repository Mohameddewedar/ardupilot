# User-confirmed hardware: STM32F429I-DISC1 (MB1075), stock Discovery board.
MCU STM32F4xx STM32F429xx
APJ_BOARD_ID 5656
OSCILLATOR_HZ 8000000
STM32_ST_USE_TIMER 5
FLASH_SIZE_KB 2048

# Sector 0: bootloader; sectors 1 and 2: redundant parameter storage.
FLASH_RESERVE_START_KB 64
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

# No analog power or airspeed sensors are fitted to the stock board.
define HAL_USE_ADC FALSE

USB_STRING_MANUFACTURER "MTC/GuidancePilot"

# The micro-AB connector uses the HS controller with its internal FS PHY.
# Expose it as the primary USB serial device (SDU1).
define HAL_USE_USB TRUE
define HAL_USE_SERIAL_USB TRUE
define STM32_OTG2_IS_OTG1 TRUE
SERIAL_ORDER OTG1 USART1 UART5
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL2_BAUD AP_SERIALMANAGER_GPS_BAUD/1000
PB14 OTG_HS_DM OTG2
PB15 OTG_HS_DP OTG2
PB13 VBUS INPUT
PC4 VBUS_SW OUTPUT HIGH
PC5 VBUS_OVERCURRENT INPUT

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PA9 USART1_TX USART1
PA10 USART1_RX USART1
# Keep stock SB25 off: PD2 also has a reserved LCD IM0 branch.
PC12 UART5_TX UART5
PD2 UART5_RX UART5

# Keep SD write busy waits off the external IMU's SPI4 bus.
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PE3 IMU_CS CS
SPIDEV external_imu SPI4 DEVID1 IMU_CS MODE3 1*MHZ 4*MHZ

# Intended chip mounting: native +Y forward, +X right, +Z up; verify physically.
IMU Invensense SPI:external_imu ROTATION_NONE

# SPI5 serves microSD and the onboard gyro; keep the LCD deselected.
PF7 SPI5_SCK SPI5
PF8 SPI5_MISO SPI5
PF9 SPI5_MOSI SPI5
PC1 GYRO_CS CS
PC2 LCD_CS OUTPUT HIGH
PE4 SDCARD_CS CS
SPIDEV onboard_gyro SPI5 DEVID1 GYRO_CS MODE3 1*MHZ 10*MHZ
SPIDEV sdcard SPI5 DEVID2 SDCARD_CS MODE0 400*KHZ 4*MHZ
define HAL_OS_FATFS_IO 1

# The onboard L3GD20 (I3G4250D on revision E) is gyro-only; the
# expansion provides no confirmed compass or barometer.
define HAL_BARO_ALLOW_INIT_NO_BARO

PG13 LED_GREEN OUTPUT LOW GPIO(90)
PG14 LED_RED OUTPUT LOW GPIO(91)
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91
define HAL_GPIO_LED_ON 1
