# User-confirmed hardware: STM32F429I-DISC1 (MB1075), stock Discovery board.
# Keep bootloader clock/USB aligned with hwdef.dat.
MCU STM32F4xx STM32F429xx
APJ_BOARD_ID 5656
OSCILLATOR_HZ 8000000
STM32_ST_USE_TIMER 5
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 64

define HAL_USE_USB TRUE
define HAL_USE_SERIAL_USB TRUE
define STM32_OTG2_IS_OTG1 TRUE
USB_VENDOR 0x31A2
USB_PRODUCT 0x1001
USB_STRING_MANUFACTURER "MTC/GuidancePilot"
SERIAL_ORDER OTG1 USART1
define BOOTLOADER_BAUDRATE 57600

PB14 OTG_HS_DM OTG2
PB15 OTG_HS_DP OTG2
PB13 VBUS INPUT
PC4 VBUS_SW OUTPUT HIGH
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PA9 USART1_TX USART1
PA10 USART1_RX USART1
PG13 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1
